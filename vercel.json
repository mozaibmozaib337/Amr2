{
  "rewrites": [
    {
      "source": "/api/:action(ai-health|ai-reset|ai-chat|ai-parse-quiz|ai-extract-students)",
      "destination": "/api/ai?action=:action"
    },
    {
      "source": "/((?!api/|sw\\.js|workbox-.*|manifest\\.json|manifest\\.webmanifest|registerSW\\.js|splash/.*|pdfjs/.*|pwa-.*|apple-touch-icon\\.png|splash-welcome\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
